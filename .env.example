# Optional. Overrides where whisper.worker.ts fetches model files from.
# Leave unset to use Hugging Face directly, with the /hf/ Cloudflare Pages
# Function (functions/hf/[[path]].ts) as an automatic fallback.
#
# Set this if you host the model yourself on Cloudflare R2 (recommended if
# Hugging Face is slow/blocked for your users, or you want to avoid depending
# on huggingface.co's availability). Must end with a slash, and the bucket
# must mirror the path layout <model_id>/resolve/main/<file>, e.g.:
#   https://pub-xxxxxxxx.r2.dev/
#
# VITE_MODEL_BASE_URL=/models/   (same-origin, via functions/models/[[path]].ts + R2 binding "MODELS")
